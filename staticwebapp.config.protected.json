{
  "_comment": "OPTIONAL. To require sign-in for the counselor page and its files, rename this file to staticwebapp.config.json (replacing the current one), commit, and invite your counselors under Static Web App > Role management in the Azure portal. Free plan supports the built-in GitHub / Microsoft Entra sign-in.",
  "routes": [
    {
      "route": "/api/scores",
      "methods": [
        "POST"
      ],
      "allowedRoles": [
        "scorekeeper"
      ]
    },
    {
      "route": "/scoreboard/edit.html",
      "allowedRoles": [
        "scorekeeper"
      ]
    },
    {
      "route": "/counselor/*",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/files/cybersecurity/guides/*",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/files/cybersecurity/instructor-print-pack.pdf",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/files/cybersecurity/per-warden-print-pack.pdf",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/files/cybersecurity/warden-sign-off-tracker.xlsx",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/files/cybersecurity/cup-of-the-silver-padlock-scoreboard.xlsx",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/files/ai/*",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/audio/*",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/tools/two-key-rite-display.html",
      "allowedRoles": [
        "authenticated"
      ]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/github?post_login_redirect_uri=.referrer",
      "statusCode": 302
    },
    "404": {
      "rewrite": "/index.html",
      "statusCode": 404
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".m4a": "audio/mp4"
  },
  "platform": {
    "apiRuntime": "node:20"
  }
}
