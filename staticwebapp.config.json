{
  "routes": [
    {
      "route": "/api/scores/*",
      "methods": [
        "POST"
      ],
      "allowedRoles": [
        "scorekeeper"
      ]
    },
    {
      "route": "/api/scores",
      "methods": [
        "POST"
      ],
      "allowedRoles": [
        "scorekeeper"
      ]
    },
    {
      "route": "/cybersecurity/scoreboard/edit.html",
      "allowedRoles": [
        "scorekeeper"
      ]
    },
    {
      "route": "/ai/scoreboard/edit.html",
      "allowedRoles": [
        "scorekeeper"
      ]
    },
    {
      "route": "/scoreboard",
      "redirect": "/cybersecurity/scoreboard/",
      "statusCode": 301
    },
    {
      "route": "/scoreboard/*",
      "redirect": "/cybersecurity/scoreboard/",
      "statusCode": 301
    },
    {
      "route": "/counselor/*",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "route": "/files/*",
      "headers": {
        "X-Robots-Tag": "noindex"
      }
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".m4a": "audio/mp4"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 404
    },
    "401": {
      "redirect": "/.auth/login/github?post_login_redirect_uri=.referrer",
      "statusCode": 302
    }
  },
  "platform": {
    "apiRuntime": "node:20"
  }
}
