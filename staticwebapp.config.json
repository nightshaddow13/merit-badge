{
  "routes": [
    {
      "route": "/api/scores/*",
      "methods": [
        "POST"
      ],
      "allowedRoles": [
        "scorekeeper"
      ]
    },
    {
      "route": "/api/scores",
      "methods": [
        "POST"
      ],
      "allowedRoles": [
        "scorekeeper"
      ]
    },
    {
      "route": "/api/twokey/reset",
      "methods": [
        "POST"
      ],
      "allowedRoles": [
        "scorekeeper"
      ]
    },
    {
      "route": "/api/forge/round",
      "methods": [
        "POST"
      ],
      "allowedRoles": [
        "scorekeeper"
      ]
    },
    {
      "route": "/api/forge/reset",
      "methods": [
        "POST"
      ],
      "allowedRoles": [
        "scorekeeper"
      ]
    },
    {
      "route": "/api/forge/award",
      "methods": [
        "POST"
      ],
      "allowedRoles": [
        "scorekeeper"
      ]
    },
    {
      "route": "/cybersecurity/scoreboard/edit.html",
      "allowedRoles": [
        "scorekeeper"
      ]
    },
    {
      "route": "/ai/scoreboard/edit.html",
      "allowedRoles": [
        "scorekeeper"
      ]
    },
    {
      "route": "/cybersecurity/scoreboard/two-key-check.html",
      "redirect": "/cybersecurity/two-key-rite/",
      "statusCode": 301
    },
    {
      "route": "/scoreboard",
      "redirect": "/cybersecurity/scoreboard/",
      "statusCode": 301
    },
    {
      "route": "/scoreboard/*",
      "redirect": "/cybersecurity/scoreboard/",
      "statusCode": 301
    },
    {
      "route": "/counselor/tools/two-key-rite-display.html",
      "allowedRoles": [
        "counselor",
        "scorekeeper"
      ],
      "headers": {
        "X-Robots-Tag": "noindex",
        "Cache-Control": "private, no-store"
      }
    },
    {
      "route": "/counselor/",
      "allowedRoles": [
        "counselor"
      ]
    },
    {
      "route": "/counselor/*",
      "allowedRoles": [
        "counselor"
      ],
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "Cache-Control": "private"
      }
    },
    {
      "route": "/files/*",
      "headers": {
        "X-Robots-Tag": "noindex"
      }
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".m4a": "audio/mp4"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 404
    },
    "401": {
      "redirect": "/.auth/login/github?post_login_redirect_uri=.referrer",
      "statusCode": 302
    },
    "403": {
      "rewrite": "/access-denied.html",
      "statusCode": 403
    }
  },
  "platform": {
    "apiRuntime": "node:22"
  }
}
